# --- Resend ---
# API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Every outgoing mail is sent from this address. It must be on a domain you have
# verified in Resend (or use onboarding@resend.dev for testing).
# A display name is optional: "Sagar <me@yourdomain.com>"
MAILBOX_ADDRESS=you@yourdomain.com

# --- Mailbox login (the single account that can use the portal) ---
MAILBOX_USER=admin
MAILBOX_PASSWORD=change-me
# Signs the session cookie. Any long random string: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string
# How long a login survives WITHOUT activity. The expiry slides forward while you
# keep using the app, so this is an inactivity window, not a hard cap. Default 30.
# SESSION_DAYS=30

# --- Attachments on outgoing mail (all optional) ---
# Resend's hard ceiling is 40 MB per email AFTER base64 encoding, so the total
# below cannot exceed 30 — the server refuses to start if it does. The Express
# body limit is derived from it, so raising the total is enough. Watch your
# proxies too (Vercel rewrite, Railway) once files get large.
# MAX_ATTACHMENT_COUNT=10
# MAX_ATTACHMENT_MB=10
# MAX_ATTACHMENTS_TOTAL_MB=20

# --- Scheduled sending ---
# A scheduled mail is stored in MongoDB and only handed to Resend on the day it
# goes out, by a dispatcher that runs at 00:00 UTC inside this process. That is
# deliberate: Resend's quota is a UTC calendar day, so calling them on the
# delivery day puts the send in that day's allowance no matter whether Resend
# counts it at call time or at delivery time. It also means a date's bookings
# never spend the allowance of the day you happened to book them on, so a week
# of mail can be laid out in one sitting.
#
# The dispatcher needs no configuration. It also sweeps on every boot, so a
# redeploy or outage across midnight still gets that day's mail out — anything
# whose time has already passed is sent at once and marked late.
#
# How many may be scheduled for any one date. Counted per recipient, so a bulk
# send to 50 people spends 50. Defaults to RESEND_DAILY_QUOTA minus
# RESEND_DAILY_RESERVE (100 - 20 = 80) and is clamped to that, so the ledger can
# never book a date past what Resend will deliver on it. Set it only to go lower.
# MAX_SCHEDULED_PER_DAY=80
# How far ahead Resend accepts a schedule. Their number, not ours — it has
# moved before (72 hours once), so it is configurable rather than hardcoded.
# MAX_SCHEDULE_DAYS=30

# --- Resend plan limits ---
# Your plan's daily email allowance. Resend has no endpoint that reports how
# much is left, so it is set here. Free is 100/day. It is a UTC calendar day,
# 00:00-24:00, which is why every window in this app is UTC — the allowance
# therefore resets at 05:30 IST, as every screen showing it says.
# RESEND_DAILY_QUOTA=100
# Held back from scheduling and never bookable in advance. A date's allowance is
# shared by scheduled mail, mail you send by hand that day, and mail that
# ARRIVES — received email counts against the quota too, one apiece. Without a
# reserve, a fully booked date would silently reject your inbox.
# RESEND_DAILY_RESERVE=20
# Resend's rate limit, used to pace bulk sends. Default is 2/second per team.
# RESEND_SENDS_PER_SECOND=2
# How long to wait out a 429 before retrying the same recipient.
# RATE_LIMIT_BACKOFF_MS=5000
# A ceiling on one bulk job, separate from the daily caps above.
# MAX_BULK_RECIPIENTS=500

# --- MongoDB (stores drafts, read/unread state, schedules and bulk sends) ---
# Atlas: Database → Connect → Drivers, then paste the SRV string.
MONGO_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Local instead: MONGO_URI=mongodb://localhost:27017
MONGO_DB=mailbox

# --- Server ---
PORT=4000

# Browser origins allowed to call this API, comma separated. Entries may be an
# exact origin, "*.vercel.app" to cover preview deploys, or "*".
# Not needed at all if the frontend proxies /api to this service (see README).
CORS_ORIGIN=http://localhost:5173

# --- Session cookie ---
# lax  : frontend and API share an origin (local dev, or a Vercel /api rewrite)
# none : frontend and API are on different sites (Vercel -> Railway directly).
#        Implies Secure, and Safari blocks it as a third-party cookie.
COOKIE_SAMESITE=lax
# Defaults to true when NODE_ENV=production. Forced true when SameSite=none.
# COOKIE_SECURE=true
# Trust the platform's X-Forwarded-* headers. Defaults to true in production.
# TRUST_PROXY=true
